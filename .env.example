# ⚠️ RENOMBRAR este archivo a ".env.example"
# (el asistente no puede crear archivos .env* por seguridad del sandbox)
#
# ── Base de datos (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# ── JWT / Auth ─────────────────────────────────────────────────
SECRET_KEY=cambiar-por-una-clave-secreta-de-minimo-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (orígenes permitidos, JSON array) ─────────────────────
CORS_ORIGINS=["http://localhost:5173"]

# ── Cookies (dev: False/lax · prod: True/strict + HTTPS) ───────
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ── Login con Google (Client ID — es público, del proyecto de Google Cloud) ──
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ── n8n (webhook que envía los emails de reseteo de contraseña) ──
N8N_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/food-store-reset

# ── URLs del sistema ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# BACKEND_URL: dominio público (ngrok) para que MercadoPago redirija y llame al webhook
BACKEND_URL=https://tu-dominio.ngrok-free.dev

# ── MercadoPago (Checkout PRO) ─────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-0000000000
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
MP_SANDBOX=true
# Firma secreta del webhook IPN: panel MP → Tus integraciones → Webhooks → Clave secreta
MP_WEBHOOK_SECRET=tu-firma-secreta-del-webhook
# Opcional: URL fija del webhook IPN (si no usás un ngrok dinámico)
MP_NOTIFICATION_URL=

# ── Cloudinary (gestión de imágenes) ───────────────────────────
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
